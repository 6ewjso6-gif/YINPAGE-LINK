{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	}
}
