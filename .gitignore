# Gradle
.gradle/
build/
app/build/
module/build/
gradle-home/
.gradle-home/

# Kotlin 编译会话
.kotlin/

# 本机构建环境（各人自行下载，不入库）
_tools/

# 逆向中间产物（含官方 APK，体积大且涉及版权，不入库）
_rev/

# IDE
.idea/
*.iml
.vscode/
captures/

# 本地配置
local.properties
probe.txt

# 本机自动生成的 debug 签名目录（由 app/module build.gradle.kts 指向 .android/）
# 仅仓库内的通用 debug keystore 例外入库，见文件末尾
.android/*

# 签名（绝不入库）
*.jks
*.keystore

# 例外：debug keystore 是 Android 公开通用调试密钥（storepass/keypass=android），
# 不含任何发布密钥；入库后新机器 ./build.sh 可直接构建，无需本地生成。
!.android/debug.keystore
keystore.properties

# 系统
.DS_Store
Thumbs.db
