<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================================
         YINPAGE-LINK LSPosed 模块
         该 APK 本身只提供「配置界面 + 模块元数据」，真正的逻辑运行在
         被 Hook 的系统进程里（com.android.bluetooth / com.milink.service
         / com.android.systemui / com.android.settings / com.xiaomi.bluetooth）。
         ============================================================ -->

    <!-- S5：模块配置含跨进程 IPC 令牌等敏感数据，禁止云备份 / 换机迁移 -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_lock_silent_mode_off"
        android:label="@string/module_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YinpageModule">

        <!-- 模块描述界面：LSPosed 管理器点「模块」后打开这里 -->
        <activity
            android:name=".ModuleActivity"
            android:exported="true"
            android:label="@string/module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 模块状态查询 provider。
             仅模块自身进程使用：外部 App 无需（也无权）探测模块是否激活。
             之前 exported=true 且无权限，任意 App 都能查询用户是否安装了本模块，
             属于可被用于指纹识别 / 定向攻击的信息泄漏，v0.14 起关闭导出。 -->
        <provider
            android:name=".ModuleStatusProvider"
            android:authorities="com.yinpage.link.module.status"
            android:exported="false" />
    </application>
</manifest>
