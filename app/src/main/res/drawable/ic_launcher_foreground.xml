<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：耳机剪影 + 声波。
  108x108 画布，内容全部落在中心 66dp 安全圆内（x/y 约 21..87），
  因此圆形/方形/圆角矩形遮罩都不会切到主体。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 头梁：从 (31,64) 顺时针掠过顶部到 (77,64)（sweep-flag=1 在 y 向下的坐标系里是顺时针） -->
    <path
        android:pathData="M31,64 A23,23 0 0 1 77,64"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 左耳罩（圆角矩形 23..39 x 58..82，圆角 7） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M30,58 h2 a7,7 0 0 1 7,7 v10 a7,7 0 0 1 -7,7 h-2 a7,7 0 0 1 -7,-7 v-10 a7,7 0 0 1 7,-7 z" />

    <!-- 右耳罩（圆角矩形 69..85 x 58..82，圆角 7） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M76,58 h2 a7,7 0 0 1 7,7 v10 a7,7 0 0 1 -7,7 h-2 a7,7 0 0 1 -7,-7 v-10 a7,7 0 0 1 7,-7 z" />

    <!-- 两侧发声单元暗示（半透明内圈） -->
    <path
        android:fillColor="#40000000"
        android:pathData="M31,67 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 z" />
    <path
        android:fillColor="#40000000"
        android:pathData="M77,67 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 z" />

    <!-- 中间两道声波：左「(」右「)」 -->
    <path
        android:pathData="M45,72 a10,10 0 0 1 0,-12"
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M63,60 a10,10 0 0 1 0,12"
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

</vector>
