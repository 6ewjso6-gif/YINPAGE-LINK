<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下的备份规则（android:fullBackupContent）。

  S5 修复：`yinpage_link_settings.xml` 中含 `last_addr` / `last_name`
  （耳机 MAC + 名称），属于隐私敏感信息 —— 原文件注释声称"不带任何蓝牙
  配对信息"与实际不符。SharedPreferences 无法按 key 拆分备份，因此这里
  **整体排除**该 prefs，云备份与换机迁移都不再带上耳机标识。
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="yinpage_link_settings.xml" />
</full-backup-content>