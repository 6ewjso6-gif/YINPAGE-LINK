<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则（android:dataExtractionRules）。

  S5 修复：`yinpage_link_settings.xml` 含 `last_addr` / `last_name`
  （耳机 MAC + 名称），云备份与设备迁移都不应携带。SharedPreferences 无法
  按 key 拆分规则，故整体排除该 prefs（开关类配置无隐私属性，丢失可接受）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="yinpage_link_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="yinpage_link_settings.xml" />
    </device-transfer>
</data-extraction-rules>