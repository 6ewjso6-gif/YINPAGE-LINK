<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme.YinpageLink —— 只服务「进入 Compose 之前」的窗口外观（窗口背景 / 状态栏 / 启动瞬间）。

  ⚠️ 重要说明（与需求文档的一处偏差，已在交付汇报里注明）：
      需求写的是继承 Theme.Material3.DayNight.NoActionBar，但该样式属于
      com.google.android.material:material（Material Components for Android），
      本工程 app/build.gradle.kts 并未声明该依赖，若照写会直接导致 aapt2 资源链接失败
      （resource style/Theme.Material3.DayNight.NoActionBar not found）。
      因此这里改用平台主题作为父样式，界面观感完全由 Compose Material3 负责。
      若后续要恢复 Material3 XML 主题，只需：
        1) 在 app/build.gradle.kts 加入 implementation("com.google.android.material:material:<ver>")
        2) 把 parent 改回 "Theme.Material3.DayNight.NoActionBar"
-->
<resources>

    <style name="Theme.YinpageLink" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 系统栏：深色底 + 浅色图标；Compose 里 enableEdgeToEdge() 会接管后续表现 -->
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- minSdk 27 == API 27，该属性自 API 27 起可用 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/brand_primary</item>
    </style>

</resources>
