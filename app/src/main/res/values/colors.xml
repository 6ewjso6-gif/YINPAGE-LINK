<?xml version="1.0" encoding="utf-8"?>
<!--
  XML 侧颜色资源。Compose 内的完整配色见 ui/theme/Color.kt，
  这里只保留窗口/主题需要的少量颜色，避免两份配色互相漂移。
-->
<resources>
    <!-- 窗口背景（浅色）：深色值见 values-night/colors.xml，避免启动瞬间白/黑闪烁 -->
    <color name="window_background">#FFF6F7FB</color>

    <!-- 品牌主色（低饱和青蓝），用于系统强调色与通知图标着色 -->
    <color name="brand_primary">#FF3F63C8</color>
    <color name="brand_primary_light">#FFAEC3FF</color>
    <color name="brand_surface_light">#FFF6F7FB</color>
    <color name="brand_on_surface">#FFE6E8EF</color>
</resources>
